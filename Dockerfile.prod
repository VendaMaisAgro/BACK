# ---------- build ----------
FROM node:20-alpine AS build
WORKDIR /app

# Otimização: Não baixar Chromium no build (economiza ~300MB)
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
COPY tsconfig.json ./
COPY src ./src

# Prisma client + build TS
RUN npx prisma generate
RUN npm run build

# ---------- runtime ----------
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Instalar apenas Chromium essencial (otimizado)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    ca-certificates

# Dizer pro Puppeteer onde está o Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Copiar package files
COPY --from=build /app/package.json /app/package-lock.json ./

# Copiar apenas prisma (sem node_modules ainda)
COPY --from=build /app/prisma ./prisma

# Instalar APENAS dependências de produção (sem devDependencies)
# Isso reduz ~500MB removendo TypeScript, ESLint, @types/*, etc
RUN npm ci --omit=dev --ignore-scripts && \
    npx prisma generate && \
    npm cache clean --force

# Copiar código compilado
COPY --from=build /app/dist ./dist

EXPOSE 5000
CMD ["node", "dist/server.js"]
